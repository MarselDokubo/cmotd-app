{
  "name": "cmotd-component-tailwind-project",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1",
    "dev": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind.css -o ./assets/css/tailwind-build.css --watch",
    "build": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind.css -o ./assets/css/tailwind-build.css --minify",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "node ./scripts/validate-project.mjs",
    "check": "npm run build && npm run validate"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "http-server": "14.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "3.4.17"
  }
}
